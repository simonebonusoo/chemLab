{
  "name": "chemlab",
  "version": "1.0.0",
  "private": true,
  "description": "ChemLab — modular platform for chemistry work (MVP monorepo)",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @chemlab/web dev",
    "build": "pnpm --filter @chemlab/chemistry build && pnpm --filter @chemlab/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @chemlab/chemistry test:watch",
    "lint": "pnpm -r --if-present lint",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules"
  }
}
