{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemLab",
  "version": "1.0.0",
  "identifier": "app.chemlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @chemlab/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @chemlab/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChemLab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
